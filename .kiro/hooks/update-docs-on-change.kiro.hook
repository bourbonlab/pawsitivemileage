{
  "enabled": true,
  "name": "Update Docs on Source Change",
  "description": "When source files (TypeScript, config, CDK, shell scripts) are edited, ask the agent to review and update relevant documentation in README.md or the docs/ folder to keep them in sync with code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.sh",
      "**/*.css",
      ".env.example",
      "tsconfig.base.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if any documentation needs updating. Check README.md and files in the docs/ folder. If the change affects project structure, API routes, commands, environment variables, dependencies, or any documented behavior, update the relevant docs to stay in sync. Only make doc changes when the code change meaningfully impacts what's documented — don't update docs for trivial or internal-only changes."
  },
  "workspaceFolderName": "PawsitiveMileage",
  "shortName": "update-docs-on-change"
}