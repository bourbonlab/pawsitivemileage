{
  "name": "@pawsitivemileage/pm",
  "version": "0.1.0",
  "private": true,
  "description": "pm: the PawsitiveMileage command line, built on @pawsitivemileage/sdk",
  "type": "module",
  "bin": {
    "pm": "dist/pm.mjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/pm.mjs --banner:js='#!/usr/bin/env node'",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "pm": "tsx src/index.ts"
  },
  "dependencies": {
    "@pawsitivemileage/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
