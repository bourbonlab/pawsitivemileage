{
  "name": "pawsitive-mileage",
  "version": "0.1.0",
  "private": true,
  "description": "PawsitiveMileage monorepo root \u2014 npm workspaces + shared tooling for CDK bundling",
  "workspaces": [
    "packages/*",
    "api",
    "web",
    "cli",
    "pm",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
