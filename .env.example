# PawsitiveMileage — Environment Secrets & Configuration
# Copy this file to .env and fill in your values.
# This file is sourced by deploy.sh and should NEVER be committed to git.

# ── Google OAuth 2.0 credentials (from Google Cloud Console) ─────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── ACM wildcard certificate ARN (us-east-1, required for custom domains) ────
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:817281265012:certificate/7deaab89-f198-4e82-af07-ff0e63441e6d

# ── Domain configuration (per environment) ───────────────────────────────────
# Frontend domains
FRONTEND_DOMAIN_TEST=pawsitivemileagetest.bourbonlab.net
FRONTEND_DOMAIN_STAGING=pawsitivemileagestaging.bourbonlab.net
FRONTEND_DOMAIN_PRODUCTION=pawsitivemileage.bourbonlab.net

# API domains
API_DOMAIN_TEST=pawsitivemileageapitest.bourbonlab.net
API_DOMAIN_STAGING=pawsitivemileageapistaging.bourbonlab.net
API_DOMAIN_PRODUCTION=pawsitivemileageapi.bourbonlab.net

# Resource name prefix (used for S3 buckets, stack names, etc.)
RESOURCE_PREFIX=pawsitivemileage

# Cognito hosted UI domain prefix (must NOT contain "aws" — Cognito rejects it)
# "pawsitivemileage" contains "aws" in "p-aws-itive", so we use an alternate prefix
COGNITO_DOMAIN_PREFIX=pmileage

# ── CloudFlare cache purge (optional) ────────────────────────────────────────
# If your DNS is proxied through CloudFlare, set these to auto-purge on deploy.
# Leave blank or remove if you don't use CloudFlare.
# Zone ID: CloudFlare dashboard → your domain → Overview → right sidebar
# API token: https://dash.cloudflare.com/profile/api-tokens → Zone:Cache Purge:Purge
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ── Cognito stack outputs (set after first deploy) ──────────────────────────
# These are required for the frontend build. Get them from CDK stack outputs:
#   aws cloudformation describe-stacks --stack-name <prefix>-<env>-auth \
#     --query "Stacks[0].Outputs"
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
