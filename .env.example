# PawsitiveMileage — Environment Secrets & Configuration
# Copy this file to .env and fill in your values.
# This file is sourced by deploy.sh and should NEVER be committed to git.

# ── AWS account & credentials ────────────────────────────────────────────────
# CLI profile used by deploy.sh for every aws/cdk call (exported automatically).
AWS_PROFILE=pawsitivemileage
# Each environment is pinned to an account; deploy.sh refuses to run if the
# active credentials belong to a different account.
AWS_ACCOUNT_ID_STAGING=123456789012
AWS_ACCOUNT_ID_PRODUCTION=123456789012

# ── Google OAuth 2.0 credentials (from Google Cloud Console) ─────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── AWS Secrets Manager — Google OAuth client secret (per environment) ────────
# Store the Google client secret in Secrets Manager (in the target account) and put the secret name/ARN here.
# The CDK Auth stack reads the secret at deploy time via SecretValue.secretsManager().
GOOGLE_CLIENT_SECRET_ARN_STAGING=your-secrets-manager-secret-name-or-arn-staging
GOOGLE_CLIENT_SECRET_ARN_PRODUCTION=your-secrets-manager-secret-name-or-arn-production

# ── ACM certificate ARN (MUST be in us-east-1) ───────────────────────────────
# Covers the apex and wildcard (e.g. example.app + *.example.app). Used by
# CloudFront, the API Gateway custom domain, and the Cognito custom domain.
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-certificate-id

# ── Domain configuration (per environment) ───────────────────────────────────
# Single-level subdomains so the wildcard certificate covers every host.
# Cognito requires the apex (pawsitivemileage.app) to resolve to an A record
# before an auth.* custom domain can be created.
FRONTEND_DOMAIN_STAGING=staging.pawsitivemileage.app
FRONTEND_DOMAIN_PRODUCTION=pawsitivemileage.app

API_DOMAIN_STAGING=api-staging.pawsitivemileage.app
API_DOMAIN_PRODUCTION=api.pawsitivemileage.app

# Cognito Hosted UI custom domain (CNAME must be DNS-only in CloudFlare, not proxied)
AUTH_DOMAIN_STAGING=auth-staging.pawsitivemileage.app
AUTH_DOMAIN_PRODUCTION=auth.pawsitivemileage.app

# Resource name prefix (S3 bucket names are global — must not collide with any other account)
RESOURCE_PREFIX=pawsitivemileage-app

# ── Frontend branding (baked into Vite build via VITE_ prefix) ───────────────
# Source code repository URL (leave blank to hide the link)
SOURCE_CODE_URL=https://github.com/org/PawsitiveMileage
# Support email shown on Privacy Policy and Terms of Service pages
SUPPORT_EMAIL=support@pawsitivemileage.app

# ── CloudFlare cache purge (optional) ────────────────────────────────────────
# If your DNS is proxied through CloudFlare, set these to auto-purge on deploy.
# Leave blank or remove if you don't use CloudFlare.
# Zone ID: CloudFlare dashboard → your domain → Overview → right sidebar
# API token: https://dash.cloudflare.com/profile/api-tokens → Zone:Cache Purge:Purge
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ── Cognito stack outputs (set after first deploy) ──────────────────────────
# These are required for the frontend build. Get them from CDK stack outputs:
#   aws cloudformation describe-stacks --stack-name <prefix>-<env>-auth \
#     --query "Stacks[0].Outputs"
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
