{
  "name": "pawsitive-mileage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handlers/*.ts --bundle --platform=node --target=node24 --outdir=dist --format=esm --external:@aws-sdk/*",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1049.0",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/lib-dynamodb": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.27.7",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
