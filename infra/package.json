{
  "name": "pawsitive-mileage-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "synth:github-access": "cdk synth --app \"npx tsx bin/github-access.ts\"",
    "deploy:github-access": "cdk deploy --app \"npx tsx bin/github-access.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1146.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  }
}
